{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeRDSInstances",
      "Effect": "Allow",
      "Action": ["rds:DescribeDBInstances"],
      "Resource": "*"
    },
    {
      "Sid": "ReadRegisteredDBSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:REPLACE_WITH_EACH_REGISTERED_SECRET_ARN-*"
      ]
    }
  ]
}
