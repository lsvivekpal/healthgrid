# Copy to .env for local/private deployment configuration.
# Never commit .env or put it inside a Docker image.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-Fernet.generate_key-output
DJANGO_ALLOWED_HOSTS=dashboard.example.com
DJANGO_USE_HTTPS=true
DJANGO_ALLOW_HTTP=false
CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
DJANGO_MFA_REQUIRED=true
DJANGO_HSTS_SECONDS=31536000
DB_SSL_MODE=require
# Only needed when DB_SSL_MODE=verify-full.
DB_SSL_ROOT_CERT=

# Restrict to the actual Teams/Power Automate webhook hostnames used by your tenant.
WEBHOOK_ALLOWED_HOSTS=approved-teams-host.example.com

# Production application database.
DATABASE_URL=postgres://user:password@db-host:5432/rds_dashboard
